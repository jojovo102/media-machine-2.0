library/**
!library/index.json
!library/README.md
!library/os-screens/
library/os-screens/*
!library/os-screens/index.json
jobs/
vendor/
.env
.env.*
*.log
.DS_Store
node_modules/
brands/*/.music-pool.json
.watch/

